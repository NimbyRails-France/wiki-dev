{
  "name": "@nimbyrails-france/wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "npm run edition:check && nuxt build",
    "generate": "npm run edition:check && nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:generated": "node scripts/check-generated.mjs",
    "api:sync": "node scripts/sync-api.mjs",
    "api:check": "node scripts/sync-api.mjs --check",
    "postinstall": "nuxt prepare",
    "edition:capture": "node scripts/snapshot-edition.mjs",
    "edition:check": "node scripts/snapshot-edition.mjs --check"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
